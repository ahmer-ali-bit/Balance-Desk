rules_version = '2';

// ---------------------------------------------------------------------------
// Security model for the linked-devices (cloud sync) feature.
//
// The app talks to Firestore through the REST API with an API key and does not
// sign in, so rules cannot be scoped to a user yet. Access is therefore
// capability based: a document can only be reached by a client that already
// knows an unguessable id, and `list` is denied everywhere the app does not
// need it, so collections cannot be enumerated.
//
//   * linked_workspaces ids: 128-bit random, only ever shared through the
//     invite link / QR code.
//   * linked_invites tokens: 12 characters from a 32 character alphabet
//     (~60 bits) and valid for 10 minutes.
//
// `list` stays allowed on the workspace sub-collections because the sync
// engine pages through them with `runQuery`.
//
// Residual risk: any client that obtains a workspace id can read and write
// that workspace. Closing this properly needs Firebase Auth (or a small
// server-side proxy) so rules can check `request.auth.uid` against the
// workspace document. Do not widen these rules back to `allow read` on
// linked_invites / linked_workspaces.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Linked Invites (used for QR / code sharing).
    //    Lookup is a direct document read by token, so `get` is enough.
    //    `list` is denied: listing this collection would hand out every live
    //    invite code, and an invite code is enough to join a workspace.
    match /linked_invites/{inviteToken} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // 2. Linked Workspaces (control document + synced ledger data).
    //    The control document holds the device roster, the active invite and
    //    the dataChangedAt marker. Sub-collections hold the synced records:
    //    ledger_years, customers, entries, summary_snapshots and app_settings.
    //
    //    `list` on the parent collection is denied so the workspaces of every
    //    other shop cannot be discovered by browsing.
    match /linked_workspaces/{workspaceId} {
      allow get: if true;
      allow list: if false;
      allow write: if true;

      // The catch-all is written as two explicit levels on purpose. A
      // `{document=**}` wildcard also matches zero segments, which would make
      // this block cover the parent document path as well and quietly turn the
      // `list: if false` above into a no-op — verified against the live project:
      // listing linked_workspaces answered 200 until this was narrowed.
      match /{collectionId}/{documentId} {
        allow read, write: if true;
      }
    }

    // 3. Default Deny.
    //    The legacy collections that older builds used (workspace_snapshots,
    //    linked_sessions, devices_v2, linkedSessions_v2, inviteLinks_v2) are
    //    deliberately absent: no current code path reads or writes them, so
    //    they stay closed instead of being left world writable.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
